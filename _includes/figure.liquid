{% assign img_path = include.path | remove: '.jpg' %}

<figure>
  <picture>
    {% if site.imagemagick.enabled %}
      <source
        class="responsive-img-srcset"
        srcset="{% for width in site.imagemagick.widths %}{{ img_path | relative_url }}-{{ width }}.webp {{ width }}w,{% endfor %}"
        sizes="95vw"
        type="image/webp"
      >
    {% endif %}
    <img
      src="{{ include.path | relative_url | bust_file_cache }}"
      class="{{ include.class }}"
      width="100%"
      height="auto"
      alt="{{ include.alt }}"
      loading="{{ include.loading | default: 'lazy' }}"
      onerror="this.onerror=null; $('.responsive-img-srcset').remove();"
    >
  </picture>
</figure>
